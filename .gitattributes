# COBOL files should use IBM-1047 (EBCDIC) encoding
*.cbl zos-working-tree-encoding=IBM-1047
*.cob zos-working-tree-encoding=IBM-1047
*.CBL zos-working-tree-encoding=IBM-1047
*.COB zos-working-tree-encoding=IBM-1047

# COBOL copybooks
*.cpy zos-working-tree-encoding=IBM-1047
*.CPY zos-working-tree-encoding=IBM-1047

# JCL files
*.jcl zos-working-tree-encoding=IBM-1047
*.JCL zos-working-tree-encoding=IBM-1047

# BMS Maps
*.bms zos-working-tree-encoding=IBM-1047
*.BMS zos-working-tree-encoding=IBM-1047

etc/install/base/uss_build/scripts/envsubst binary