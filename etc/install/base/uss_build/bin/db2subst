#!/usr/bin/env python3
"""
db2subst - Substitute ${VAR} references in a Db2 input file using build.conf values
This is a backward-compatible wrapper that calls envsubst.
For new code, use envsubst directly.

Usage: db2subst <input_file> [--config <build.conf>]
Copyright IBM Corp. 2023, 2025
"""

import os
import sys
from pathlib import Path

# Get the directory containing this script
script_dir = Path(__file__).resolve().parent

# Call envsubst with the same arguments
envsubst_path = script_dir / 'envsubst'
os.execv(sys.executable, [sys.executable, str(envsubst_path)] + sys.argv[1:])

# Made with Bob